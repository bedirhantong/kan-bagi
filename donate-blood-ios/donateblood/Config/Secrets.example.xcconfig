// Bu dosyayı Secrets.xcconfig olarak kopyalayıp doldurun (Secrets.xcconfig git'e girmez).
// NOT: xcconfig'de "//" yorum sayılır; URL'lerde $(SLASH) kullanın.
SLASH = /

// ---- Supabase (Project Settings > API). Yalnızca anon/publishable key; service_role ASLA buraya koymayın.
SUPABASE_URL = https:$(SLASH)$(SLASH)YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY

// ---- Google girişi (opsiyonel): Google Cloud Console > iOS OAuth client
GOOGLE_IOS_CLIENT_ID = 1234567890-abc.apps.googleusercontent.com
// Client ID'nin ters çevrilmiş hali: com.googleusercontent.apps.1234567890-abc
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc

// ---- Push bildirimleri / OneSignal (opsiyonel; boş bırakırsanız push kapalı, uygulama yine çalışır)
// OneSignal paneli > Settings > Keys & IDs > OneSignal App ID. Ayrıntı: docs/PUSH_NOTIFICATIONS.md
// ONESIGNAL_APP_ID = 00000000-0000-0000-0000-000000000000

// ---- İmzalama (kendi Apple hesabınız). Simülatörde boş bırakabilirsiniz.
// APP_BUNDLE_ID = com.yourname.bloodapp
// APP_DEVELOPMENT_TEAM = ABCDE12345
// Ücretli hesap: Sign in with Apple + Push yetkileri için
// APP_ENTITLEMENTS = donateblood.entitlements

// ---- İsteğe bağlı
// SOURCE_CODE_URL = https:$(SLASH)$(SLASH)github.com$(SLASH)sizin-hesabiniz$(SLASH)depo-adi   // Hakkında ekranındaki "Açık kaynak kodu" bağlantısı
// EMAIL_LOGIN_ENABLED = YES   // Release'de test girişini açar (TestFlight test kullanıcıları için)

// ---- Bağlantılar (isteğe bağlı). Varsayılan: ana proje deposu. Kendi kopyanızda kendi sayfalarınızı yazın.
// SOURCE_CODE_URL = https:$(SLASH)$(SLASH)github.com/KULLANICI/REPO
// TERMS_URL = https:$(SLASH)$(SLASH)example.org/terms
// PRIVACY_URL = https:$(SLASH)$(SLASH)example.org/privacy
