    "about.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app does not verify donations and does not provide medical advice. In emergencies contact a healthcare provider."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama bağışların gerçekleştiğini doğrulamaz ve tıbbi tavsiye vermez. Acil durumlarda sağlık kuruluşuyla iletişime geçin."
          }
        }
      }
    },
